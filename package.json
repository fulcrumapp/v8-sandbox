{
  "name": "@fulcrumapp/v8-sandbox",
  "version": "3.2.13",
  "description": "V8 Sandbox",
  "homepage": "http://github.com/fulcrumapp/v8-sandbox",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "binding.gyp",
    "src/",
    "dist/"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "configure": "node-gyp configure",
    "build": "node-gyp configure build && tsc",
    "build-debug": "node-gyp --debug configure build && tsc",
    "rebuild": "node-gyp configure rebuild",
    "test": "vitest run",
    "clean": "rm -rf dist build",
    "lint": "eslint 'lib/**/*.ts'",
    "typecheck": "tsc -b"
  },
  "engines": {
    "node": ">=22.22.2"
  },
  "author": "Zac McCormick <zac.mccormick@gmail.com> (http://github.com/zhm)",
  "license": "BSD",
  "repository": {
    "type": "git",
    "url": "git://github.com/fulcrumapp/v8-sandbox.git"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "js-yaml": "^5.5.0",
    "node-gyp": "^13.1.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "axios": "^1.21.1",
    "signal-exit": "^4.1.0"
  },
  "keywords": [
    "sandbox",
    "v8",
    "js",
    "javascript"
  ]
}
