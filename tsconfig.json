{
  "include": ["lib/**/*"],
  "compilerOptions": {
    "target": "es2022",
    "sourceMap": true,
    "rootDir": "lib",
    "outDir": "dist",
    "strict": false,
    "lib": ["esnext"],
    "module": "commonjs",
    "types": ["node"],
    "allowJs": true,
    "esModuleInterop": true,
    "noImplicitAny": false,
    "declaration": true
  }
}